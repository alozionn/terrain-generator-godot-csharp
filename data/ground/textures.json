    { "id": "dirt",   "albedoHeight": "res://assets/textures/ground/ground103_alb_ht.png", "normalRoughness": "res://assets/textures/ground/ground103_nrm_rgh.png", "uvScale": 0.15 },
    { "id": "litter", "albedoHeight": "res://assets/textures/ground/leaves009_alb_ht.png", "normalRoughness": "res://assets/textures/ground/leaves009_nrm_rgh.png", "uvScale": 0.18 },
    { "id": "dry",    "albedoHeight": "res://assets/textures/ground/ground109_alb_ht.png", "normalRoughness": "res://assets/textures/ground/ground109_nrm_rgh.png", "uvScale": 0.15 }
  ]
