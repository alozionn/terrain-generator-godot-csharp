{
  "version": 1,
  "id": "kenney_ground",
  // ground.json with Kenney Nature Kit models. The kit is about 1/6 of real size (stones about 1 m across, 0.3 m tall)
  // and footprints are multiplied by instance scale, so they are small numbers in the kenney_* sets.
  "species": [
    { "id": "rocks", "meshes": ["k_stone_a", "k_stone_b", "k_stone_c", "k_mossy_a", "k_mossy_b"], "density": 1.0, "spacing": 5, "footprint": 0.85,
      "height": [0.2, 6], "maxSlope": 40, "playableMargin": 1, "scale": [1.2, 2.6], "tilt": 15, "tintJitter": 0.06,
      "alignToSlope": 0.4, "sink": [0.05, 0.2],
      "clusters": { "frequency": 0.05, "threshold": -0.2, "softness": 0.3 } },
    { "id": "boulders", "meshes": ["k_stone_tall_a", "k_stone_tall_b", "k_stone_b"], "density": 3, "spacing": 3.5, "footprint": 0.8,
      "height": [4, 20], "maxSlope": 45, "playableMargin": 2, "scale": [1.2, 2.4], "tilt": 10, "tintJitter": 0.05,
      "ridge": [-1, -0.15], "alignToSlope": 0.7, "sink": [0.3, 0.7] },
    { "id": "scree", "meshes": ["k_pebble_a", "k_pebble_b", "k_pebble_c"], "density": 14, "spacing": 1.4,
      "height": [3, 20], "maxSlope": 50, "playableMargin": 1, "scale": [0.8, 1.6], "tilt": 30, "tintJitter": 0.08,
      "ridge": [-1, -0.3], "alignToSlope": 0.5, "sink": [0.02, 0.08] },
    { "id": "shore_stones", "meshes": ["k_pebble_a", "k_pebble_b", "k_pebble_c"], "density": 6, "spacing": 1.5,
      "bands": ["shore", "sand"], "height": [-0.5, 1.2], "maxSlope": 30, "avoidPlayable": false, "playableDensity": 0.2,
      "scale": [0.8, 1.6], "tilt": 25, "tintJitter": 0.08, "clusters": { "frequency": 0.07, "threshold": 0.1, "softness": 0.3 } },
    { "id": "pebbles", "meshes": ["k_pebble_a", "k_pebble_b", "k_pebble_c"], "density": 1.5, "spacing": 2,
      "height": [0.2, 14], "maxSlope": 35, "avoidPlayable": false, "playableDensity": 0.2,
      "scale": [0.6, 1.2], "tilt": 20 }
  ]
}
