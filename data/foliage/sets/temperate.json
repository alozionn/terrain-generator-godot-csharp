{
  "version": 1,
  "id": "temperate",
  // placed in order: big things claim space first, ground cover fills around them. Models are ~7 m trees, ~2 m rocks,
  // ~1.3 m grass clumps, so scales bring them to board size.
  "species": [
    { "id": "rocks", "meshes": ["rock_1", "rock_2", "rock_3"], "density": 1.0, "spacing": 5, "footprint": 1.6,
      "height": [0.2, 14], "maxSlope": 50, "playableMargin": 1, "scale": [0.4, 1.0], "tilt": 15, "tintJitter": 0.08,
      "clusters": { "frequency": 0.05, "threshold": -0.2, "softness": 0.3 } },
    { "id": "oaks", "meshes": ["round_tree_1"],
      "density": 6, "spacing": 4.5, "footprint": 2.8,
      "bands": ["grass", "meadow", "hill"], "height": [1.2, 8], "maxSlope": 25, "playableMargin": 3,
      "scale": [0.75, 1.1], "tilt": 3, "tintJitter": 0.08, "clusters": { "frequency": 0.02, "threshold": 0.0, "softness": 0.25 } },
    { "id": "pines", "meshes": ["pine_1", "pine_2", "pine_3", "pine_4", "pine_5"], "density": 8, "spacing": 3.5, "footprint": 2,
      "bands": ["hill", "rock"], "height": [3, 11], "maxSlope": 38, "playableMargin": 2,
      "scale": [0.7, 1.05], "tilt": 2, "tintJitter": 0.06, "clusters": { "frequency": 0.03, "threshold": -0.15, "softness": 0.25 } },
    { "id": "bushes", "meshes": ["bush", "bush", "bush_flowers"], "density": 4, "spacing": 2.5, "footprint": 1,
      "bands": ["grass", "meadow", "hill"], "height": [1.0, 8], "maxSlope": 30, "playableMargin": 1,
      "scale": [0.7, 1.2], "tintJitter": 0.08, "clusters": { "frequency": 0.04, "threshold": -0.1, "softness": 0.3 } },
    { "id": "ferns", "meshes": ["fern", "plant_1", "plant_7"], "density": 3, "spacing": 2,
      "bands": ["grass", "meadow", "hill"], "height": [1.0, 8], "maxSlope": 30, "playableMargin": 1,
      "scale": [0.25, 0.4], "tintJitter": 0.08, "clusters": { "frequency": 0.05, "threshold": 0.2, "softness": 0.2 } },
    // grass: dense meadow patches where the noise says so, sparse tufts in between, only a few tufts on the board
    { "id": "meadow", "meshes": ["grass_common", "grass_common", "grass_wispy"], "density": 300, "spacing": 0.55,
      "bands": ["grass", "meadow", "hill"], "height": [1.0, 9], "maxSlope": 35, "avoidPlayable": false,
      "playableDensity": 0.08, "playableScale": 0.7,
      "scale": [0.45, 0.7], "tilt": 6, "tintJitter": 0.08,
      "clusters": { "frequency": 0.035, "threshold": -0.05, "softness": 0.35 } },
    { "id": "tufts", "meshes": ["grass_common", "grass_wispy"], "density": 25, "spacing": 1.4,
      "bands": ["grass", "meadow", "hill"], "height": [1.0, 9], "maxSlope": 35, "avoidPlayable": false,
      "playableDensity": 0.5, "playableScale": 0.7,
      "scale": [0.3, 0.45], "tilt": 8, "tintJitter": 0.08 },
    { "id": "flowers", "meshes": ["flowers_3", "flowers_4"], "density": 8, "spacing": 1.2,
      "bands": ["grass", "meadow"], "height": [1.0, 4], "maxSlope": 25, "avoidPlayable": false, "playableDensity": 0.3,
      "scale": [0.25, 0.4], "tilt": 6, "clusters": { "frequency": 0.08, "threshold": 0.15, "softness": 0.25 } },
    { "id": "clover", "meshes": ["clover_1", "clover_2"], "density": 6, "spacing": 1.0,
      "bands": ["grass", "meadow"], "height": [1.0, 4], "maxSlope": 25, "avoidPlayable": false, "playableDensity": 0.4,
      "scale": [0.6, 1.0], "clusters": { "frequency": 0.1, "threshold": 0.25, "softness": 0.2 } },
    { "id": "pebbles", "meshes": ["pebble_1", "pebble_2"], "density": 2, "spacing": 2,
      "height": [0.2, 10], "maxSlope": 35, "avoidPlayable": false, "playableDensity": 0.2,
      "scale": [0.6, 1.2], "tilt": 20 }
  ]
}
