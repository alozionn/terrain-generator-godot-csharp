{
  "version": 1,
  "id": "ground",
  // grows everywhere (no climate): rock outcrops and stones, placed first so every biome flows around them.
  // Rock_Medium models are about 3 m across at scale 1, so they stay well under that.
  "species": [
    // grassland rocks, a little bedded in
    { "id": "rocks", "meshes": ["rock_1", "rock_2", "rock_3"], "density": 1.0, "spacing": 5, "footprint": 1.6,
      "height": [0.2, 6], "maxSlope": 40, "playableMargin": 1, "scale": [0.4, 1.0], "tilt": 15, "tintJitter": 0.08,
      "alignToSlope": 0.4, "sink": [0.1, 0.35],
      "clusters": { "frequency": 0.05, "threshold": -0.2, "softness": 0.3 } },
    // mountain rock: fallen blocks down the gullies (where loose rock collects), never perched on the crests,
    // half buried and leaning with the slope
    { "id": "boulders", "meshes": ["rock_1", "rock_2", "rock_3"], "density": 3, "spacing": 3.5, "footprint": 1.4,
      "height": [4, 20], "maxSlope": 45, "playableMargin": 2, "scale": [0.35, 0.75], "tilt": 10, "tintJitter": 0.06,
      "ridge": [-1, -0.15], "alignToSlope": 0.7, "sink": [0.5, 0.9] },
    // scree: small stones collecting in the creases
    { "id": "scree", "meshes": ["rock_1", "rock_2", "rock_3"], "density": 14, "spacing": 1.4,
      "height": [3, 20], "maxSlope": 50, "playableMargin": 1, "scale": [0.08, 0.2], "tilt": 30, "tintJitter": 0.1,
      "ridge": [-1, -0.3], "alignToSlope": 0.5, "sink": [0.1, 0.3] },
    { "id": "shore_stones", "meshes": ["pebble_1", "pebble_2", "pebble_3"], "density": 6, "spacing": 1.5,
      "bands": ["shore", "sand"], "height": [-0.5, 1.2], "maxSlope": 30, "avoidPlayable": false, "playableDensity": 0.2,
      "scale": [0.8, 1.6], "tilt": 25, "tintJitter": 0.1, "clusters": { "frequency": 0.07, "threshold": 0.1, "softness": 0.3 } },
    { "id": "pebbles", "meshes": ["pebble_1", "pebble_2", "pebble_3"], "density": 1.5, "spacing": 2,
      "height": [0.2, 14], "maxSlope": 35, "avoidPlayable": false, "playableDensity": 0.2,
      "scale": [0.6, 1.2], "tilt": 20 }
  ]
}
