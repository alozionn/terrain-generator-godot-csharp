<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Terrain</RootNamespace>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**;.scratch/**" />
    <!-- Ship builds drop dev tools, which include the Terrain3D comparison bridge and the wrapper its bindings need -->
    <Compile Remove="dev/**;addons/terrain_3d/csharp/**" Condition="'$(Ship)'=='true'" />
  </ItemGroup>
</Project>
